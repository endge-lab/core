{
  "compilerOptions": {

    // Модули/таргет
    "target": "esnext",

    // Если есть JSX / Vue JSX
    "jsx": "preserve",
    "emitDecoratorMetadata": true,
    // Декораторы (если нужны)
    "experimentalDecorators": true,
    "rootDir": "./src",

    "module": "esnext",
    "moduleResolution": "bundler",

    // Локальные алиасы
    "paths": {
      "@endge/raph": ["../@endge-raph/dist/main.d.ts"],
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    // Безопасность
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Полезные флаги
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "src/**/*.scss"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "test"
  ]
}
